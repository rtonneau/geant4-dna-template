# Short end-to-end check used by scripts/new-project.ps1 and by the smoke test in
# .claude/geant4-instructions.md: low energy, few events.
/run/verbose 0
/tracking/verbose 0
/dnaLogger/verbose Error

/process/dna/e-SolvationSubType Ritchie1994
/process/chem/TimeStepModel SBS

/run/initialize

/gun/particle e-
/gun/energy 25 keV

/run/beamOn 2
